# Copy to ~/.config/jobnotify/config.env and fill in one channel.
# The file should stay mode 600. jobnotify sends to every filled-in channel.
# Environment variables of the same names override this file.

# --- Phone push (fastest setup) -------------------------------------------
# Install the ntfy app, or open the topic URL, and subscribe to NTFY_TOPIC.
# Use a long random topic. Anyone with the topic can read these alerts.
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=

# --- Telegram --------------------------------------------------------------
# Talk to @BotFather, create a bot, then message that bot once.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Gmail or any SMTP server ----------------------------------------------
# For Gmail, create an app password (Google Account → Security → App passwords)
# and paste it here. The normal account password will be rejected.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=

# --- Webhook, including WhatsApp via CallMeBot -----------------------------
# POST JSON {"title","body"} to WEBHOOK_URL.
# If the URL contains {message} or {title}, jobnotify sends a GET request
# with those placeholders filled. CallMeBot looks like:
# WEBHOOK_URL=https://api.callmebot.com/whatsapp.php?phone=1XXXXXXXXXX&apikey=YOURKEY&text={message}
# WEBHOOK_URL=
